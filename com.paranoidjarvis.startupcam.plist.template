<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh renders this into com.paranoidjarvis.startupcam.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.paranoidjarvis.startupcam</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO_DIR__/startup_cam_logger.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/startupcam.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/startupcam.err</string>
    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>
</dict>
</plist>
